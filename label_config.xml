<View>
  <!-- HyperText ignores the dark theme, so it gets its own light card -->
  <View style="background:#f4f4f4;color:#111;padding:12px;border-radius:6px;font-size:18px">
    <HyperText name="ctx" value="$context"/>
  </View>
  <Header value="$word"/>
  <Text name="info" value="$info"/>
  <Header size="5" value="1. Чья это речь?"/>
  <Choices name="speech" toName="ctx" choice="single" required="true" showInline="true">
    <Choice value="чеченская" hotkey="1"/>
    <Choice value="русская" hotkey="2"/>
  </Choices>
  <Header size="5" value="2. Что это за слово?"/>
  <Choices name="kind" toName="ctx" choice="single" required="true" showInline="true">
    <Choice value="обычное слово" hotkey="q"/>
    <Choice value="заимствование" hotkey="w"/>
    <Choice value="русское" hotkey="e"/>
    <Choice value="имя / название" hotkey="r"/>
    <Choice value="сокращение" hotkey="t"/>
    <Choice value="опечатка" hotkey="y"/>
  </Choices>
  <TextArea name="comment" toName="ctx" placeholder="Комментарий (по желанию)" rows="1" maxSubmissions="1" editable="true"/>
</View>
